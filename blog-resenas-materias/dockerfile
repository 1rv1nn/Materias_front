# Stage 1: Build stage
FROM node:18-alpine AS builder

# Establecer el directorio de trabajo
WORKDIR /app

# Copiar archivos de configuración de dependencias
COPY package*.json ./
COPY vite.config.js ./
COPY jest.config.cjs ./
COPY babel.config.cjs ./

# Instalar todas las dependencias (incluyendo devDependencies)
RUN npm install

# Copiar el código fuente
COPY . .

# Construir la aplicación
RUN npm run build

# Stage 2: Production stage
FROM node:18-alpine AS production

# Establecer el directorio de trabajo e instalar dependencias
WORKDIR /app

# Instalar supervisor y otras dependencias necesarias
RUN apk add --no-cache supervisor && \
    mkdir -p /var/log/supervisor && \
    npm install -g pm2 serve

# Copiar los artefactos de build y archivos de configuración
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/ecosystem.config.js ./
COPY supervisord.conf /etc/supervisord.conf
COPY start-pm2.sh ./
RUN chmod +x /app/start-pm2.sh

# Crear directorios para logs y asignar permisos
RUN mkdir -p /var/log/supervisor /var/run && \
    chmod -R 755 /var/log/supervisor && \
    chmod -R 755 /var/run && \
    chown -R node:node /app

# Exponer el puerto
EXPOSE 3000

# Salud de la aplicación
HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

# Iniciar supervisor (mantenemos root para supervisor)
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]